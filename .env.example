# Copy this file to .env and replace every password placeholder with a local lab password.
# .env is ignored by Git and must never be committed.
DB_HOST=quickbite-db
DB_PORT=5432

USER_DB_NAME=quickbite_user_db
USER_DB_USER=quickbite_user
USER_DB_PASSWORD=REPLACE_WITH_LOCAL_LAB_PASSWORD

RESTAURANT_DB_NAME=quickbite_restaurant_db
RESTAURANT_DB_USER=quickbite_restaurant
RESTAURANT_DB_PASSWORD=REPLACE_WITH_LOCAL_LAB_PASSWORD

ORDER_DB_NAME=quickbite_order_db
ORDER_DB_USER=quickbite_order
ORDER_DB_PASSWORD=REPLACE_WITH_LOCAL_LAB_PASSWORD

NOTIFICATION_DB_NAME=quickbite_notification_db
NOTIFICATION_DB_USER=quickbite_notification
NOTIFICATION_DB_PASSWORD=REPLACE_WITH_LOCAL_LAB_PASSWORD
